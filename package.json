{
  "name": "promptwars-pune-2026",
  "version": "1.0.0",
  "description": "SprintLearn — Adaptive learning assistant for 5-minute micro-learning sprints",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage --verbose",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/index.js",
      "!server/routes/**",
      "!server/services/firebaseClient.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himwalia/promptwars-pune-2026.git"
  },
  "keywords": [
    "adaptive-learning",
    "gemini",
    "hackathon",
    "sprintlearn"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/himwalia/promptwars-pune-2026/issues"
  },
  "homepage": "https://github.com/himwalia/promptwars-pune-2026#readme",
  "dependencies": {
    "@google/genai": "^1.50.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.8.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
